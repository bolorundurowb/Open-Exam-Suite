<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:OpenExamSuite.Creator.Localization"
             xmlns:vm="using:OpenExamSuite.Creator.ViewModels"
             x:Class="OpenExamSuite.Creator.Views.SectionEditorView"
             x:DataType="vm:SectionEditorViewModel">
  <StackPanel Spacing="12">
    <TextBlock Text="{loc:Loc Editor_Section}" Classes="heading"/>
    <TextBlock Text="{loc:Loc Editor_SectionName}" Classes="caption"/>
    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
  </StackPanel>
</UserControl>
