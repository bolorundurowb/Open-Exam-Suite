<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:OpenExamSuite.Simulator.Localization"
             xmlns:vm="using:OpenExamSuite.Simulator.ViewModels"
             xmlns:views="using:OpenExamSuite.Simulator.Views"
             x:Class="OpenExamSuite.Simulator.Views.ReviewSubmitView">
  <UserControl.Resources>
    <DataTemplate x:Key="UnansweredChipTemplate" DataType="vm:QuestionChipViewModel">
      <Button Theme="{StaticResource ChipButton}" Classes="wrong" Command="{Binding $parent[ItemsControl].DataContext.JumpCommand}"
              CommandParameter="{Binding}" AutomationProperties.Name="{Binding AutomationName}">
        <TextBlock Text="{Binding Number}"/>
      </Button>
    </DataTemplate>
    <DataTemplate x:Key="FlaggedChipTemplate" DataType="vm:QuestionChipViewModel">
      <Button Theme="{StaticResource ChipButton}" Classes="flag" Command="{Binding $parent[ItemsControl].DataContext.JumpCommand}"
              CommandParameter="{Binding}" AutomationProperties.Name="{Binding AutomationName}">
        <StackPanel Orientation="Horizontal" Spacing="4">
          <PathIcon Data="{StaticResource IconFlag}" Width="12" Height="12" Foreground="{DynamicResource FlagBrush}"/>
          <TextBlock Text="{Binding Number}"/>
        </StackPanel>
      </Button>
    </DataTemplate>
  </UserControl.Resources>

  <DockPanel>
    <TextBlock DockPanel.Dock="Top" Text="{Binding UrgentAnnouncement}" Width="1" Height="1" Opacity="0" IsHitTestVisible="False"
               HorizontalAlignment="Left" AutomationProperties.LiveSetting="Assertive"/>
    <Border DockPanel.Dock="Bottom" Classes="bottombar">
      <WrapPanel HorizontalAlignment="Right">
        <Button Theme="{StaticResource SecondaryButton}" Command="{Binding ToggleNavigatorCommand}" IsVisible="{Binding ShowNavigatorToggle}"
                Margin="0,0,10,0" Content="{loc:Loc Exam_Questions}"/>
        <Button Theme="{StaticResource SecondaryButton}" Command="{Binding BackCommand}" IsEnabled="{Binding CanGoBack}"
                Margin="0,0,10,0" Content="{loc:Loc Review_Back}"/>
        <Button Theme="{StaticResource PrimaryButton}" Command="{Binding SubmitCommand}" Content="{loc:Loc Review_Submit}"/>
      </WrapPanel>
    </Border>

    <Grid ColumnDefinitions="*,Auto">
      <Panel Grid.Column="0">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="900" Margin="40,24,40,24" Spacing="16" HorizontalAlignment="Stretch">

          <!-- Time up: a notice, then automatic submission. -->
          <Border Classes="banner critical" IsVisible="{Binding IsTimeUp}">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <PathIcon Data="{StaticResource IconClock}"/>
              <StackPanel>
                <TextBlock Text="{loc:Loc Review_TimeUpTitle}" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding TimeUpText}" Classes="mono"/>
              </StackPanel>
            </StackPanel>
          </Border>

          <WrapPanel>
            <TextBlock Text="{loc:Loc Review_Title}" Classes="title" Margin="0,0,24,8" VerticalAlignment="Center"/>
            <Border Classes="timer" Classes.low="{Binding IsLowTime}" Classes.critical="{Binding IsCriticalTime}"
                    IsVisible="{Binding ShowTimer}" VerticalAlignment="Center" Margin="0,0,0,8">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <PathIcon Data="{StaticResource IconClock}" Width="18" Height="18"/>
                <TextBlock Text="{Binding TimerText}" Classes="mono" FontSize="22"/>
              </StackPanel>
            </Border>
          </WrapPanel>

          <!-- Counts: tinted tiles, each with an icon and a label. -->
          <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
            <Border Grid.Column="0" Background="{DynamicResource AccentSubtleBrush}" CornerRadius="10" Padding="14">
              <StackPanel>
                <TextBlock Text="{Binding AnsweredCount}" Classes="mono" FontSize="28" FontWeight="Bold"/>
                <TextBlock Text="{loc:Loc Nav_Answered}"/>
              </StackPanel>
            </Border>
            <Border Grid.Column="1" Background="{DynamicResource WrongBgBrush}" CornerRadius="10" Padding="14">
              <StackPanel>
                <TextBlock Text="{Binding UnansweredCount}" Classes="mono wrong" FontSize="28" FontWeight="Bold"/>
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <PathIcon Data="{StaticResource IconClose}" Width="14" Height="14" Foreground="{DynamicResource WrongBrush}"/>
                  <TextBlock Text="{loc:Loc Nav_Unanswered}" Classes="wrong"/>
                </StackPanel>
              </StackPanel>
            </Border>
            <Border Grid.Column="2" Background="{DynamicResource FlagBgBrush}" CornerRadius="10" Padding="14">
              <StackPanel>
                <TextBlock Text="{Binding FlaggedCount}" Classes="mono" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource FlagBrush}"/>
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <PathIcon Data="{StaticResource IconFlag}" Width="14" Height="14" Foreground="{DynamicResource FlagBrush}"/>
                  <TextBlock Text="{loc:Loc Nav_Flagged}" Foreground="{DynamicResource FlagBrush}"/>
                </StackPanel>
              </StackPanel>
            </Border>
          </Grid>

          <!-- Unanswered chips -->
          <StackPanel Spacing="8" IsVisible="{Binding HasUnanswered}">
            <TextBlock Text="{loc:Loc Review_UnansweredHeading}" Classes="strong"/>
            <ItemsControl ItemsSource="{Binding UnansweredChips}" ItemTemplate="{StaticResource UnansweredChipTemplate}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>
          </StackPanel>

          <!-- Flagged chips -->
          <StackPanel Spacing="8" IsVisible="{Binding HasFlagged}">
            <TextBlock Text="{loc:Loc Review_FlaggedHeading}" Classes="strong"/>
            <ItemsControl ItemsSource="{Binding FlaggedChips}" ItemTemplate="{StaticResource FlaggedChipTemplate}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>
          </StackPanel>

          <Border Classes="banner info" IsVisible="{Binding !HasUnanswered}">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <PathIcon Data="{StaticResource IconCheck}"/>
              <TextBlock Text="{loc:Loc Review_AllAnswered}"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

        <!-- Narrow windows: the navigator opens over the summary. -->
        <Border IsVisible="{Binding ShowOverlayNavigator}" HorizontalAlignment="Right" Width="320"
                Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="2,0,0,0">
          <views:NavigatorPanel DataContext="{Binding Navigator}"/>
        </Border>
      </Panel>

      <!-- Wide windows: the full navigator stays beside the summary. -->
      <Border Grid.Column="1" Width="300" IsVisible="{Binding ShowInlineNavigator}"
              Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1,0,0,0">
        <views:NavigatorPanel DataContext="{Binding Navigator}"/>
      </Border>
    </Grid>
  </DockPanel>
</UserControl>
