<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="OpenExamSuite.Creator.Views.Dialogs.AddSectionDialog"
        Title="Add Section"
        Width="380" Height="180"
        MinWidth="320" MinHeight="160"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        CanResize="False">
    <Grid Margin="16" RowDefinitions="Auto,Auto,*,Auto">
        <TextBlock Grid.Row="0" Text="Section Title:" Margin="0,0,0,6"/>
        <TextBox   Grid.Row="1"
                   Name="TitleBox"
                   AcceptsReturn="False"/>
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button Content="Add"    IsDefault="True" Click="OnAdd"    Width="90"/>
            <Button Content="Cancel" IsCancel="True"  Click="OnCancel" Width="90" Margin="8,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>
