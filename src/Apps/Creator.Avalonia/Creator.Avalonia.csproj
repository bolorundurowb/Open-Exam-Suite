<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>WinExe</OutputType>
    <ApplicationIcon>CreatorAppIcon.ico</ApplicationIcon>
    <AssemblyName>OpenExamSuite.Creator.Avalonia</AssemblyName>
    <RootNamespace>OpenExamSuite.Creator</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <NeutralLanguage>en</NeutralLanguage>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Libraries\Core\Core.csproj" />
    <ProjectReference Include="..\..\Libraries\ExamIO\ExamIO.csproj" />
    <ProjectReference Include="..\..\Libraries\Logging\Logging.csproj" />
    <ProjectReference Include="..\..\Libraries\Storage\Storage.csproj" />
    <ProjectReference Include="..\Creator.Session\Creator.Session.csproj" />
    <ProjectReference Include="..\..\Libraries\Shared.Avalonia\Shared.Avalonia.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <AvaloniaResource Include="CreatorAppIcon.ico" Link="Assets\CreatorAppIcon.ico" />
    <AvaloniaResource Include="..\..\..\CHANGELOG.md" Link="Assets\CHANGELOG.md" />
    <AvaloniaResource Include="..\..\..\LICENSE" Link="Assets\LICENSE.txt" />
  </ItemGroup>

  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <None Include="..\..\..\samples\*.oef" Link="Samples\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
