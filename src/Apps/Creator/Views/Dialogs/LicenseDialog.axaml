<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="OpenExamSuite.Creator.Views.Dialogs.LicenseDialog"
        Title="License"
        Icon="avares://OpenExamSuite.Creator/Assets/CreatorAppIcon.ico"
        Width="760" Height="640" MinWidth="480" MinHeight="360"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Classes="bottombar">
      <Button Classes="accent" Content="Close" HorizontalAlignment="Right" VerticalAlignment="Center"
              MinHeight="40" Padding="16,7" Click="Close_Click" IsDefault="True" IsCancel="True"/>
    </Border>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" Padding="28,20">
      <SelectableTextBlock x:Name="DocumentText" TextWrapping="Wrap" FontSize="13"
                           FontFamily="avares://OpenExamSuite.Shared.Avalonia/Assets/Fonts#IBM Plex Mono"/>
    </ScrollViewer>
  </DockPanel>
</Window>
