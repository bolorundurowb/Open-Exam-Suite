<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>WinExe</OutputType>
    <ApplicationIcon>SimulatorAppIcon.ico</ApplicationIcon>
    <AssemblyName>OpenExamSuite.Simulator</AssemblyName>
    <RootNamespace>OpenExamSuite.Simulator</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <NeutralLanguage>en</NeutralLanguage>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- XmlSerializer and protobuf-net reflection do not survive trimming or AOT. Lock both off. -->
    <PublishTrimmed>false</PublishTrimmed>
    <PublishAot>false</PublishAot>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Win32.SystemEvents" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Libraries\Core\Core.csproj" />
    <ProjectReference Include="..\..\Libraries\ExamIO\ExamIO.csproj" />
    <ProjectReference Include="..\..\Libraries\Logging\Logging.csproj" />
    <ProjectReference Include="..\..\Libraries\Storage\Storage.csproj" />
    <ProjectReference Include="..\Simulator.Session\Simulator.Session.csproj" />
    <ProjectReference Include="..\..\Libraries\Shared.Avalonia\Shared.Avalonia.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OpenExamSuite.Simulator.Tests" />
    <InternalsVisibleTo Include="OpenExamSuite.App.Headless.Tests" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <AvaloniaResource Include="SimulatorAppIcon.ico" Link="Assets\SimulatorAppIcon.ico" />
    <AvaloniaResource Include="..\..\..\CHANGELOG.md" Link="Assets\CHANGELOG.md" />
    <AvaloniaResource Include="..\..\..\LICENSE" Link="Assets\LICENSE.txt" />
  </ItemGroup>

  <!-- Installed builds get {app}/Samples from the installer. Development runs read them from the output folder. -->
  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <None Include="..\..\..\samples\*.oef" Link="Samples\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
