<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:OpenExamSuite.Simulator.Localization"
             xmlns:vm="using:OpenExamSuite.Simulator.ViewModels"
             x:Class="OpenExamSuite.Simulator.Views.NavigatorPanel">
  <!-- Question navigator grouped by section. DataContext is a NavigatorViewModel. -->
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="12" Margin="18">
      <TextBlock Text="{loc:Loc Nav_Title}" Classes="strong"/>

      <!-- Legend: every state has a shape or glyph as well as colour. -->
      <WrapPanel>
        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,12,6">
          <Border Width="16" Height="16" CornerRadius="4" BorderThickness="1.5" BorderBrush="{DynamicResource ControlBorderBrush}"
                  Background="{DynamicResource SurfaceBrush}"/>
          <TextBlock Text="{loc:Loc Nav_Unanswered}" FontSize="11" Foreground="{DynamicResource BodyBrush}" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,12,6">
          <Border Width="16" Height="16" CornerRadius="4" Background="{DynamicResource AccentBrush}">
            <PathIcon Data="{StaticResource IconCheck}" Width="11" Height="11" Foreground="{DynamicResource OnAccentBrush}"/>
          </Border>
          <TextBlock Text="{loc:Loc Nav_Answered}" FontSize="11" Foreground="{DynamicResource BodyBrush}" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,12,6">
          <Border Width="16" Height="16" CornerRadius="4" BorderThickness="1.5" BorderBrush="{DynamicResource FlagBrush}"
                  Background="{DynamicResource FlagBgBrush}">
            <PathIcon Data="{StaticResource IconFlag}" Width="10" Height="10" Foreground="{DynamicResource FlagBrush}"/>
          </Border>
          <TextBlock Text="{loc:Loc Nav_Flagged}" FontSize="11" Foreground="{DynamicResource FlagBrush}" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,12,6">
          <Border Width="16" Height="16" CornerRadius="5" BorderThickness="2" BorderBrush="{DynamicResource TextBrush}">
            <Border CornerRadius="3" Margin="1" Background="{DynamicResource AccentBrush}"/>
          </Border>
          <TextBlock Text="{loc:Loc Nav_Current}" FontSize="11" Foreground="{DynamicResource BodyBrush}" VerticalAlignment="Center"/>
        </StackPanel>
      </WrapPanel>

      <ItemsControl ItemsSource="{Binding Sections}">
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="vm:NavSectionViewModel">
            <StackPanel Spacing="6" Margin="0,0,0,10">
              <TextBlock Text="{Binding Title}" Classes="label"/>
              <ItemsControl ItemsSource="{Binding Cells}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel/>
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="vm:NavCellViewModel">
                    <Button Theme="{StaticResource NavCell}" Command="{Binding JumpCommand}"
                            Classes.answered="{Binding IsAnswered}" Classes.flagged="{Binding IsFlagged}" Classes.current="{Binding IsCurrent}"
                            AutomationProperties.Name="{Binding AutomationName}">
                      <Grid Width="38" Height="31">
                        <TextBlock Text="{Binding Number}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <PathIcon Data="{StaticResource IconFlag}" IsVisible="{Binding IsFlagged}" Width="10" Height="10"
                                  HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,2,0"/>
                        <PathIcon Data="{StaticResource IconCheck}" IsVisible="{Binding IsAnswered}" Width="10" Height="10"
                                  HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,2,2"/>
                      </Grid>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
